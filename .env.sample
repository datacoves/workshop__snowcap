# Snowflake connection used by plan.sh / apply.sh.
# Copy to .env and fill in. .env is git-ignored.

SNOWFLAKE_ACCOUNT=                                   # Account identifier, e.g. MYORG-MYACCOUNT
SNOWFLAKE_USER=                                      # Service account / user name

# Role used to plan and apply. Snowcap here creates databases, warehouses,
# roles, users and grants, so it needs the matching account privileges.
# SECURITYADMIN alone cannot create databases or warehouses -- see the
# prerequisites in README.md.
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Key-pair (JWT) auth. The public key must be registered on the target account
# (ALTER USER <you> SET RSA_PUBLIC_KEY='...') -- a key that works on one account
# is not automatically valid on another.
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/your/private-key.pem
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT

# Optional / unused with key-pair auth.
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_ACCOUNT_PII=

# Snowflake connection used by setup.sh / plan.sh / deploy.sh.
# Copy to .env and fill in. .env is git-ignored.

SNOWFLAKE_ACCOUNT=                                   # Account identifier, e.g. MYORG-MYACCOUNT
SNOWFLAKE_USER=                                      # Service account / user name

# Role used by plan.sh and deploy.sh. DCM runs the whole deployment as this one
# role, so it needs every privilege the project uses. setup.sh grants it the
# account-level ones (CREATE DATABASE / CREATE WAREHOUSE / CREATE DCM PROJECT),
# so a role like SECURITYADMIN works -- it does not have to be ACCOUNTADMIN.
SNOWFLAKE_ROLE=SECURITYADMIN

# Role used ONLY by setup.sh, for the one-time bootstrap that creates the
# project's home database and issues the grants above. Must be able to create a
# database and grant account-level privileges. Defaults to ACCOUNTADMIN.
# DCM_SETUP_ROLE=ACCOUNTADMIN

# Key-pair (JWT) auth. The public key must be registered on the target account
# (ALTER USER <you> SET RSA_PUBLIC_KEY='...') -- a key that works on one account
# is not automatically valid on another.
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/your/private-key.pem
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT

# DCM project identifier (DB.SCHEMA.PROJECT). setup.sh creates DB + SCHEMA to
# hold the project object; change this if those names collide with anything.
DCM_PROJECT=dcm.projects.workshop
